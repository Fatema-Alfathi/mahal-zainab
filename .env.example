# Server only. Do not prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Legacy alternative, if the project still uses the service_role JWT:
# SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=replace-with-at-least-16-random-characters

# Dress photos on Cloudinary (optional). Server only: no NEXT_PUBLIC_ prefix.
# Simplest: cloud name + an UNSIGNED upload preset (no secret needed).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
# Or signed uploads instead of a preset (Settings > API Keys):
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# If none are set, photos go to Supabase Storage as before.
